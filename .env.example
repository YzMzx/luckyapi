# SQLite 数据文件路径；Docker 镜像内默认使用 /app/data/luckydraw.db
SQLITE_PATH=data/luckydraw.db

# 自托管运行所需的本地占位配置
APP_ID=self-hosted
APP_SECRET=self-hosted
DATABASE_URL=local

# Linux.do Connect OAuth
# 回调地址：https://你的域名/api/oauth/callback
# 也可在管理员后台填写；后台保存的配置优先且即时生效。
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_PRIMARY_ORIGIN=https://lucky.example.com

# 管理后台初始账号。部署前必须将密码改成独立的高强度随机值。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# 对外映射端口
PORT=3000
